{
  "manifest_version": "1.0",
  "name": "OBS Studio",
  "description": "Record video and stream live.",
  "version": "32.1.0",
  "image": "ghcr.io/containerpak/obs-studio:main",
  "binaries": ["/usr/bin/obs"],
  "desktop_entries": ["/usr/share/applications/com.obsproject.Studio.desktop"],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": true,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSessionBus": true,
    "socketSystemBus": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "socketAtSpiBus": true,
    "socketBluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": true,
    "deviceVideo": true,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": true,
    "fsHost": false,
    "fsHostEtc": false,
    "fsHostHome": true,
    "fsExtra": [],
    "env": [],
    "network": true,
    "process": false,
    "asRoot": false,
    "allowedHostCommands": []
  }
}
